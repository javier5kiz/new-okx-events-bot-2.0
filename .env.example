# ── OKX API (set these as HuggingFace Space *Secrets*, never commit real values) ──
OKX_API_KEY=your_api_key
OKX_SECRET_KEY=your_secret_key
OKX_PASSPHRASE=your_passphrase

# ── Mode ──────────────────────────────────────────────────────────
# true  = OKX DEMO key (simulated)   false = LIVE key.  Demo and live keys are NOT interchangeable.
IS_DEMO=false

# ── Region (only if your OKX account is NOT on www.okx.com) ───────
# EU: https://eea.okx.com    US: https://app.okx.com
# OKX_BASE_URL=https://www.okx.com

# ── Server ────────────────────────────────────────────────────────
# HuggingFace Spaces routes to 7860
PORT=7860

# ── Position (fixed, no martingale) ───────────────────────────────
TRADE_SIZE=0.1
# USD kept in the TRADING account for instant entries; everything else stays in FUNDING.
# Refilled from funding at startup and after every trade (live only). 0.1 contracts @ ~10c = ~$0.01
TRADING_FLOAT_USD=0.02

# ── Optional Discord alerts ───────────────────────────────────────
# DISCORD_WEBHOOK_URL=
